{
  "redirects": [
    {
      "destination": "/family",
      "source": "/parent-pending",
      "permanent": false
    },
    {
      "destination": "/family",
      "source": "/parent-portal/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
