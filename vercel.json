{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "destination": "/family",
      "permanent": false,
      "source": "/parent-pending"
    },
    {
      "destination": "/family",
      "permanent": false,
      "source": "/parent-portal"
    },
    {
      "destination": "/family",
      "permanent": false,
      "source": "/parent-portal/"
    },
    {
      "destination": "/family",
      "permanent": false,
      "source": "/parent-portal/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
