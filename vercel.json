{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "destination": "/family",
      "permanent": false,
      "source": "/parent-pending"
    },
    {
      "destination": "/family",
      "permanent": false,
      "source": "/parent-portal"
    },
    {
      "destination": "/family",
      "permanent": false,
      "source": "/parent-portal/"
    },
    {
      "destination": "/family",
      "permanent": false,
      "source": "/parent-portal/:path*"
    }
  ]
}
