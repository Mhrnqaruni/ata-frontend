{
  "name": "ata-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --cache --cache-location .cache/eslint/ .",
    "lint:prune": "eslint . --prune-suppressions",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"tests/**/*.{js,mjs,cjs}\" \"scripts/**/*.{js,mjs}\" \"*.config.js\"",
    "format:check": "prettier --check --cache --cache-location .cache/prettier/.prettier-cache \"src/**/*.{js,jsx}\" \"tests/**/*.{js,mjs,cjs}\" \"scripts/**/*.{js,mjs}\" \"*.config.js\"",
    "test": "node --test \"tests/*.test.*\"",
    "sizes": "node scripts/check-sizes.mjs",
    "sizes:update": "node scripts/check-sizes.mjs --update",
    "maps": "node scripts/maps.mjs",
    "check": "bash scripts/check.sh",
    "check:fast": "bash scripts/check.sh --fast"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.15.15",
    "@mui/material": "^5.15.15",
    "@tanstack/react-query": "5.105.0",
    "@vercel/speed-insights": "^1.2.0",
    "axios": "^1.6.8",
    "html-to-image": "^1.11.13",
    "katex": "^0.16.27",
    "mathjs": "^15.1.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.8",
    "react-markdown": "^9.0.1",
    "react-pdf": "^7.7.3",
    "react-router-dom": "^6.22.3",
    "recharts": "^2.12.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "uuid": "^11.1.0",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "esbuild": "0.21.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "react-test-renderer": "18.3.1",
    "vite": "^5.2.0"
  }
}
